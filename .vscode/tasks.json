{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "pf3v.vcxproj",
                "/p:Configuration=Debug",
                "/p:Platform=Win32"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "buildX64",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "pf3v.vcxproj",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build&Detail",
            "type": "shell",
            "command": "msbuild pf3v.vcxproj /t:rebuild > build.txt",
            "args": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "msbuild pf3v.vcxproj /t:clean",
            "args": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "copy-output",
            "type": "shell",
            "command": "copy",
            "args": [
                "${workspaceFolder}\\Debug\\pf3_32.dll",
                "D:\\new_zsqht\\T0002\\dlls",
                "/y"
            ],
            "dependsOn": "build",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}